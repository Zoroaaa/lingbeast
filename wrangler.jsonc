{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lingbeast-rpg",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lingbeast",
      "database_id": "dade37ce-d154-4868-9cbb-cb7d0af27ac6"
    }
  ]
}
